<script>
  // header scroll state
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
  });

  // budget builder state
  const state = { budget: 2000, travelers: 2, duration: '5 days', interests: ['Food','Culture','Anime & Pop Culture'] };

  const budgetRange = document.getElementById('budgetRange');
  const budgetOut = document.getElementById('budgetOut');
  budgetRange.addEventListener('input', e => {
    state.budget = +e.target.value;
    budgetOut.textContent = '$' + state.budget.toLocaleString();
    renderPreview();
  });

  const travelerCount = document.getElementById('travelerCount');
  document.getElementById('inc').addEventListener('click', () => {
    state.travelers = Math.min(state.travelers + 1, 10);
    travelerCount.textContent = state.travelers;
    renderPreview();
  });
  document.getElementById('dec').addEventListener('click', () => {
    state.travelers = Math.max(state.travelers - 1, 1);
    travelerCount.textContent = state.travelers;
    renderPreview();
  });

  document.querySelectorAll('#durationRow .pill-select').forEach(el => {
    el.addEventListener('click', () => {
      document.querySelectorAll('#durationRow .pill-select').forEach(e => e.classList.remove('active'));
      el.classList.add('active');
      state.duration = el.dataset.val;
      renderPreview();
    });
  });

  document.querySelectorAll('#interestRow .chip').forEach(el => {
    el.addEventListener('click', () => {
      el.classList.toggle('active');
      state.interests = [...document.querySelectorAll('#interestRow .chip.active')].map(c => c.textContent);
      renderPreview();
    });
  });

  function renderPreview(){
    const interestsText = state.interests.length
      ? state.interests.join(', ')
      : 'anything you love';
    document.getElementById('previewText').innerHTML =
      `With <em>$${state.budget.toLocaleString()}</em> for <em>${state.travelers} traveler${state.travelers>1?'s':''}</em> over <em>${state.duration}</em>, focused on <em>${interestsText}</em> — a personal Kyoto itinerary is ready to be designed.`;
  }
  renderPreview();

  // mobile hamburger (simple toggle placeholder — expand nav-links as a dropdown)
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');
  hamburger.addEventListener('click', () => {
    const open = navLinks.style.display === 'flex';
    navLinks.style.cssText = open
      ? ''
      : 'display:flex; flex-direction:column; position:fixed; top:64px; left:0; right:0; background:var(--paper); padding:24px; gap:20px; border-bottom:1px solid var(--line);';
  });
</script>
